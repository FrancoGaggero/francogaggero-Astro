---
import type { Lang } from '../i18n/ui';
import { useTranslations, localize } from '../i18n/utils';
import { featuredProjects, projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const total = featuredProjects.length + 1;
---

<section id="projects" class="relative">
	<div data-hscroll class="relative flex min-h-[100svh] flex-col justify-center overflow-hidden py-24 lg:h-[100svh] lg:py-0">
		<div class="mx-auto mb-10 flex w-full max-w-6xl flex-col justify-between gap-6 px-6 md:flex-row md:items-end">
			<div>
				<p class="kicker reveal">{t('projects.kicker')}</p>
				<h2 class="reveal mt-5 font-display text-4xl font-bold leading-tight tracking-tight text-white sm:text-6xl" style="--d:80ms">
					{t('projects.title1')} <span class="text-gradient">{t('projects.title2')}</span>
				</h2>
				<p class="reveal mt-4 max-w-lg text-slate-400" style="--d:140ms">{t('projects.body')}</p>
			</div>
			<div class="reveal flex shrink-0 items-center gap-4 font-mono text-xs text-slate-500">
				<span><span data-hcount class="text-white">01</span> / {String(total).padStart(2, '0')}</span>
				<span class="relative h-px w-28 overflow-hidden bg-white/10"><span data-hbar class="absolute inset-y-0 left-0 w-full origin-left scale-x-0 bg-gradient-to-r from-cyan-400 to-violet-400"></span></span>
				<span class="hidden uppercase tracking-widest lg:inline">{t('projects.drag')} →</span>
			</div>
		</div>

		<div data-htrack class="hscroll-native flex gap-5 px-6 lg:w-max lg:px-[max(1.5rem,calc((100vw-72rem)/2+1.5rem))]">
			{featuredProjects.map((p, i) => (
				<div class="w-[85vw] shrink-0 snap-start sm:w-[420px] lg:w-[440px]">
					<ProjectCard project={p} lang={lang} index={i} />
				</div>
			))}
			<a href={localize(lang, '/projects')} class="group flex w-[85vw] shrink-0 snap-start flex-col items-center justify-center gap-4 rounded-3xl border border-dashed border-white/15 p-10 text-center transition-colors hover:border-cyan-300/50 sm:w-[340px]">
				<span class="flex h-16 w-16 items-center justify-center rounded-full bg-gradient-to-br from-cyan-400 to-violet-500 text-2xl text-void transition-transform duration-500 group-hover:rotate-[-45deg] group-hover:scale-110">→</span>
				<span class="font-display text-2xl font-semibold text-white">{t('projects.all')}</span>
				<span class="font-mono text-xs text-slate-500">+{projects.length - featuredProjects.length} {lang === 'es' ? 'proyectos más' : 'more projects'}</span>
			</a>
		</div>
	</div>
</section>

<style>
	/* Mobile / reduced motion: native horizontal scroll with snap */
	.hscroll-native {
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
		padding-bottom: 1rem;
	}
	.hscroll-native::-webkit-scrollbar {
		display: none;
	}
	:global(.hscroll-pinned) .hscroll-native {
		overflow: visible;
		scroll-snap-type: none;
	}
</style>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	const section = document.querySelector<HTMLElement>('[data-hscroll]');
	const track = section?.querySelector<HTMLElement>('[data-htrack]');
	const count = section?.querySelector<HTMLElement>('[data-hcount]');
	const bar = section?.querySelector<HTMLElement>('[data-hbar]');

	if (section && track && count && bar) {
		const n = track.children.length;
		const setProgress = (p: number) => {
			bar.style.transform = `scaleX(${p})`;
			count.textContent = String(Math.min(n, Math.floor(p * (n - 1) + 1.5))).padStart(2, '0');
		};

		gsap.registerPlugin(ScrollTrigger);
		const mm = gsap.matchMedia();
		mm.add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
			section.classList.add('hscroll-pinned');
			const distance = () => Math.max(0, track.scrollWidth - window.innerWidth);
			const tween = gsap.to(track, {
				x: () => -distance(),
				ease: 'none',
				scrollTrigger: {
					trigger: section,
					start: 'top top',
					end: () => `+=${distance()}`,
					pin: true,
					scrub: 0.8,
					invalidateOnRefresh: true,
					onUpdate: (self) => setProgress(self.progress),
				},
			});
			// subtle parallax on each cover image
			track.querySelectorAll<HTMLElement>('img').forEach((img) => {
				gsap.fromTo(img, { xPercent: -4, scale: 1.12 }, { xPercent: 4, scale: 1.12, ease: 'none', scrollTrigger: { trigger: img, containerAnimation: tween, start: 'left right', end: 'right left', scrub: true } });
			});
			return () => section.classList.remove('hscroll-pinned');
		});

		// Native scroller progress (mobile)
		track.addEventListener('scroll', () => {
			const max = track.scrollWidth - track.clientWidth;
			if (max > 0) setProgress(track.scrollLeft / max);
		}, { passive: true });
	}
</script>
