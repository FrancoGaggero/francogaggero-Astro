---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { stack, workflows, sphereItems } from '../data/stack';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const initials = (name: string) => name.replace(/[^A-Za-z#+]/g, '').slice(0, 2);
---

<section id="stack" class="relative overflow-hidden py-28 sm:py-36">
	<div class="pointer-events-none absolute inset-0" aria-hidden="true">
		<div class="absolute -left-40 top-1/3 h-[500px] w-[500px] rounded-full bg-cyan-500/10 blur-[130px]"></div>
	</div>

	<div class="relative mx-auto max-w-6xl px-6">
		<p class="kicker reveal">{t('stack.kicker')}</p>
		<h2 class="reveal mt-5 font-display text-4xl font-bold leading-tight tracking-tight text-white sm:text-6xl" style="--d:80ms">
			{t('stack.title1')}<br /><span class="text-gradient">{t('stack.title2')}</span>
		</h2>
		<p class="reveal mt-5 max-w-xl text-slate-400" style="--d:140ms">{t('stack.body')}</p>

		<div class="mt-14 grid items-center gap-10 lg:grid-cols-[400px_1fr]">
			<!-- 3D sphere -->
			<div class="reveal">
				<div id="tech-sphere" class="relative mx-auto aspect-square w-full max-w-[400px] cursor-grab touch-none select-none" aria-hidden="true">
					<div class="absolute inset-[18%] rounded-full bg-gradient-to-br from-cyan-400/10 to-violet-500/10 blur-2xl"></div>
					<div class="absolute inset-[10%] rounded-full border border-white/5"></div>
					{sphereItems.map((item) => (
						<span data-sphere-item class="absolute left-1/2 top-1/2 flex h-12 w-12 items-center justify-center rounded-2xl border border-white/10 bg-[#0b0d14]/80 shadow-lg backdrop-blur will-change-transform" title={item.name}>
							<svg viewBox="0 0 24 24" class="h-6 w-6" fill={item.color}><path d={item.path} /></svg>
						</span>
					))}
				</div>
				<p class="mt-3 text-center font-mono text-[11px] uppercase tracking-widest text-slate-500">↔ {t('stack.drag')}</p>
			</div>

			<!-- Category marquees -->
			<div class="flex min-w-0 flex-col gap-3">
				{stack.map((cat, row) => (
					<div class="reveal group/row flex items-center gap-4" style={`--d:${row * 60}ms`}>
						<span class="hidden w-32 shrink-0 font-mono text-[11px] uppercase tracking-widest text-slate-500 sm:block">{cat.label[lang]}</span>
						<div class="marquee-mask relative min-w-0 flex-1 overflow-hidden py-1.5">
							<p class="mb-1 font-mono text-[10px] uppercase tracking-widest text-slate-500 sm:hidden">{cat.label[lang]}</p>
							<div class="marquee-track flex w-max gap-2.5" style={`animation-duration:${26 + row * 6}s; animation-direction:${row % 2 ? 'reverse' : 'normal'}`}>
								{[0, 1].map((copy) =>
									cat.items.map((item) => (
										<span class="tech-chip" style={`--c:${item.color}`} aria-hidden={copy === 1 ? 'true' : undefined}>
											{item.path ? (
												<svg viewBox="0 0 24 24" class="h-4 w-4 shrink-0" fill={item.color}><path d={item.path} /></svg>
											) : (
												<span class="flex h-4 min-w-4 items-center justify-center rounded bg-white/10 px-0.5 font-mono text-[9px] font-bold" style={`color:${item.color}`}>{item.badge ?? initials(item.name)}</span>
											)}
											{item.name}
										</span>
									)),
								)}
							</div>
						</div>
					</div>
				))}
			</div>
		</div>

		<!-- Workflows -->
		<div class="mt-20">
			<p class="reveal mb-5 font-mono text-xs uppercase tracking-widest text-slate-500">{t('stack.workflows')}</p>
			<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
				{workflows.map((w, i) => (
					<div class:list={['reveal spot-card p-5', i === 0 && 'sm:col-span-2 lg:col-span-1 !border-cyan-300/25 bg-cyan-300/[0.04]']} style={`--d:${(i % 3) * 70}ms`} data-spotlight-card>
						<div class="relative z-10">
							<p class="flex items-center gap-2 font-display font-semibold text-white">
								<span class="font-mono text-neon-cyan">{String(i + 1).padStart(2, '0')}</span>
								{w.name}
							</p>
							<p class="mt-1.5 text-sm leading-relaxed text-slate-400">{w.desc[lang]}</p>
						</div>
					</div>
				))}
			</div>

		</div>
	</div>
</section>

<style>
	.marquee-mask {
		mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
		-webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
	}
	.marquee-track {
		animation-name: stack-marquee;
		animation-timing-function: linear;
		animation-iteration-count: infinite;
	}
	.group\/row:hover .marquee-track {
		animation-play-state: paused;
	}
	@keyframes stack-marquee {
		from { transform: translateX(0); }
		to { transform: translateX(calc(-50% - 0.3125rem)); }
	}
	.tech-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		white-space: nowrap;
		border-radius: 9999px;
		border: 1px solid rgba(255, 255, 255, 0.08);
		background: rgba(255, 255, 255, 0.03);
		padding: 0.45rem 0.9rem;
		font-size: 0.875rem;
		color: rgb(203 213 225);
		transition: border-color 0.3s, color 0.3s, box-shadow 0.3s, transform 0.3s;
	}
	.tech-chip:hover {
		color: #fff;
		border-color: color-mix(in srgb, var(--c) 60%, transparent);
		box-shadow: 0 0 24px -6px var(--c);
		transform: translateY(-2px);
	}
	@media (prefers-reduced-motion: reduce) {
		.marquee-track { animation: none; flex-wrap: wrap; width: auto; }
		.marquee-track [aria-hidden='true'] { display: none; }
	}
</style>

<script>
	import { initTechSphere } from '../scripts/tech-sphere';
	const el = document.getElementById('tech-sphere');
	if (el) initTechSphere(el);
</script>
