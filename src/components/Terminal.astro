---
import type { Lang } from '../i18n/ui';
import { useTranslations, alternatePath } from '../i18n/utils';
import { featuredProjects, projects, PLAY_STORE_URL } from '../data/projects';
import { stack, workflows, learning } from '../data/stack';
import { timeline } from '../data/timeline';
import type { TerminalData } from '../scripts/terminal';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const capibara = projects.find((p) => p.slug === 'capibara')!;
const data: TerminalData = {
	lang,
	altUrl: alternatePath(Astro.url, lang === 'es' ? 'en' : 'es'),
	email: 'gaggero25@gmail.com',
	projects: featuredProjects.map((p) => ({ title: p.title, desc: p.desc[lang], url: p.live ?? p.playStore, repo: p.repo })),
	stack: stack.map((c) => ({ id: c.id, label: c.label[lang], items: c.items.map((i) => i.name) })),
	learning: learning.map((l) => l.name),
	workflows: workflows.map((w) => w.name),
	timeline: timeline.map((c) => ({ date: c.date, type: c.type, msg: c.msg[lang] })),
	game: { title: capibara.title, url: PLAY_STORE_URL },
};
const suggestions = ['help', 'whoami', 'skills', 'skills testing', 'projects', 'experience', 'contact', 'sudo hire-me'];
---

<section id="terminal" class="relative overflow-x-clip py-28 sm:py-36">
	<div class="pointer-events-none absolute inset-0" aria-hidden="true">
		<div class="absolute left-1/2 top-1/2 h-[500px] w-[800px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-emerald-500/[0.07] blur-[130px]"></div>
	</div>
	<div class="relative mx-auto max-w-4xl px-6">
		<p class="kicker reveal">{t('terminal.kicker')}</p>
		<h2 class="reveal mt-5 font-display text-4xl font-bold leading-tight tracking-tight text-white sm:text-6xl" style="--d:80ms">
			{t('terminal.title1')} <span class="text-gradient">{t('terminal.title2')}</span>
		</h2>
		<p class="reveal mt-4 text-slate-400" style="--d:140ms">{t('terminal.body')} <kbd class="ml-1 rounded border border-white/15 bg-white/5 px-1.5 py-0.5 font-mono text-xs text-slate-300">/</kbd></p>

		<div id="term" class="reveal relative mt-10 overflow-hidden rounded-2xl border border-white/10 bg-[#07080d]/90 font-mono text-[13px] shadow-[0_30px_100px_-30px_rgba(52,211,153,0.35)] sm:text-sm" style="--d:200ms">
			<div class="flex items-center gap-2 border-b border-white/5 px-4 py-3">
				<span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
				<span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
				<span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
				<span class="ml-3 text-xs text-slate-500">franco@portfolio — zsh</span>
			</div>
			<div data-term-body class="h-[380px] cursor-text overflow-y-auto px-4 py-4 leading-relaxed text-slate-300 sm:px-6" data-lenis-prevent>
				<div data-term-out aria-live="polite"></div>
				<form class="flex items-center gap-2" autocomplete="off">
					<label for="term-input" class="shrink-0"><span class="text-emerald-300">franco@portfolio</span><span class="text-slate-500">:~$</span></label>
					<input id="term-input" data-term-input type="text" spellcheck="false" autocapitalize="off" class="min-w-0 flex-1 bg-transparent text-white caret-cyan-300 outline-none placeholder:text-slate-600" placeholder={t('terminal.placeholder')} />
				</form>
			</div>
			<div class="flex gap-2 overflow-x-auto border-t border-white/5 px-4 py-3 [scrollbar-width:none] sm:px-6">
				{suggestions.map((s) => (
					<button type="button" data-term-suggest={s} class="shrink-0 rounded-md border border-white/10 bg-white/[0.03] px-2.5 py-1 text-xs text-slate-300 transition-colors hover:border-cyan-300/50 hover:text-white">{s}</button>
				))}
			</div>
		</div>
	</div>
</section>

<script is:inline type="application/json" id="term-data" set:html={JSON.stringify(data)} />

<script>
	import { initTerminal } from '../scripts/terminal';
	const root = document.getElementById('term');
	const raw = document.getElementById('term-data')?.textContent;
	if (root && raw) initTerminal(root, JSON.parse(raw));
</script>
