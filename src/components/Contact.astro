---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const mailto = `mailto:gaggero25@gmail.com?subject=${encodeURIComponent(t('contact.mailSubject'))}`;
---

<section id="contact" class="relative overflow-hidden py-28 sm:py-40">
	<div class="pointer-events-none absolute inset-0" aria-hidden="true">
		<div class="absolute bottom-0 left-1/2 h-[500px] w-[1000px] -translate-x-1/2 translate-y-1/2 rounded-full bg-gradient-to-r from-cyan-500/20 via-violet-600/25 to-fuchsia-500/20 blur-[120px]"></div>
		<div class="grid-floor opacity-60"></div>
	</div>

	<div class="relative mx-auto max-w-4xl px-6 text-center">
		<p class="kicker reveal justify-center">{t('contact.kicker')}</p>
		<h2 class="reveal mt-6 font-display text-5xl font-bold leading-[0.95] tracking-tight text-white sm:text-7xl" style="--d:80ms">
			{t('contact.title1')}<br /><span class="text-gradient">{t('contact.title2')}</span>
		</h2>
		<p class="reveal mx-auto mt-8 max-w-xl text-lg leading-relaxed text-slate-400" style="--d:140ms">{t('contact.body')}</p>

		<div class="reveal mt-12 flex flex-col items-center justify-center gap-4 sm:flex-row" style="--d:200ms">
			<a href={mailto} class="btn-primary !px-8 !py-4 !text-base" data-magnetic="0.3">
				<svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
				gaggero25@gmail.com
			</a>
			<a href="https://www.linkedin.com/in/francogaggero/" target="_blank" rel="noopener" class="btn-ghost !px-6 !py-4" data-magnetic="0.3">LinkedIn ↗</a>
			<a href="https://github.com/FrancoGaggero" target="_blank" rel="noopener" class="btn-ghost !px-6 !py-4" data-magnetic="0.3">GitHub ↗</a>
		</div>

		<p class="reveal mt-10 font-mono text-xs uppercase tracking-widest text-slate-500" style="--d:260ms">📍 {t('contact.location')}</p>
	</div>
</section>
