---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import portrait from '../assets/portada.jpeg';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);


const principles = [
	{ icon: '{ }', title: t('about.p1.t'), desc: t('about.p1.d') },
	{ icon: '◎', title: t('about.p2.t'), desc: t('about.p2.d') },
	{ icon: '↻', title: t('about.p3.t'), desc: t('about.p3.d') },
	{ icon: '✦', title: t('about.p4.t'), desc: t('about.p4.d') },
];
---

<section id="about" class="relative py-28 sm:py-36">
	<div class="mx-auto max-w-6xl px-6">
		<div class="grid items-center gap-14 lg:grid-cols-[1fr_380px]">
			<div>
				<p class="kicker reveal">{t('about.kicker')}</p>
				<h2 class="reveal mt-5 font-display text-4xl font-bold leading-tight tracking-tight text-white sm:text-6xl" style="--d:80ms">
					{t('about.title1')}<br /><span class="text-gradient">{t('about.title2')}</span>
				</h2>
				<p class="reveal mt-8 max-w-2xl text-lg leading-relaxed text-slate-400" style="--d:160ms">{t('about.body')}</p>

				<div class="reveal mt-10 flex items-start gap-4 rounded-2xl border border-white/5 bg-white/[0.02] p-5" style="--d:220ms">
					<div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-cyan-400/20 to-violet-500/20 text-xl">🎓</div>
					<div>
						<p class="font-mono text-xs uppercase tracking-widest text-cyan-300/80">{t('about.edu')}</p>
						<p class="mt-1 text-sm leading-relaxed text-slate-300">{t('about.edu.body')}</p>
					</div>
				</div>
			</div>

			<!-- Portrait card with tilt -->
			<div class="reveal mx-auto w-full max-w-[380px]" style="--d:200ms">
				<div class="spot-card relative overflow-hidden p-2" data-tilt="10" data-spotlight-card>
					<div class="tilt-glare" data-tilt-glare></div>
					<Image src={portrait} alt="Franco Gaggero" width={760} class="relative z-0 aspect-[4/5] w-full rounded-[1.1rem] object-cover" loading="lazy" />
					<div class="absolute inset-x-4 bottom-4 z-10 flex items-center justify-between rounded-xl border border-white/10 bg-black/50 px-4 py-3 backdrop-blur-md">
						<div>
							<p class="font-display text-sm font-semibold text-white">Franco Gaggero</p>
							<p class="font-mono text-[10px] uppercase tracking-widest text-slate-400">Buenos Aires · AR</p>
						</div>
						<span class="flex h-2.5 w-2.5 animate-pulse-dot rounded-full bg-emerald-400 shadow-[0_0_12px] shadow-emerald-400"></span>
					</div>
				</div>
			</div>
		</div>

		<!-- Principles -->
		<div class="mt-20 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
			{principles.map((p, i) => (
				<div class="reveal spot-card p-6" style={`--d:${i * 80}ms`} data-spotlight-card>
					<div class="relative z-10">
						<div class="mb-5 flex h-10 w-10 items-center justify-center rounded-lg border border-white/10 bg-white/5 font-mono text-neon-cyan">{p.icon}</div>
						<h3 class="font-display text-lg font-semibold text-white">{p.title}</h3>
						<p class="mt-2 text-sm leading-relaxed text-slate-400">{p.desc}</p>
					</div>
				</div>
			))}
		</div>

	</div>
</section>
