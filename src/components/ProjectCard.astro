---
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import type { Project } from '../data/projects';

interface Props {
	project: Project;
	lang: Lang;
	index: number;
	large?: boolean;
}
const { project: p, lang, index, large = false } = Astro.props;
const t = useTranslations(lang);

const statusLabel = p.status ? t(`status.${p.status}` as const) : null;
const statusClass = {
	new: 'border-emerald-400/30 bg-emerald-400/10 text-emerald-300',
	wip: 'border-amber-400/30 bg-amber-400/10 text-amber-300',
	featured: 'border-cyan-400/30 bg-cyan-400/10 text-cyan-300',
	uni: 'border-violet-400/30 bg-violet-400/10 text-violet-300',
}[p.status ?? 'featured'];
const primaryHref = p.live ?? p.playStore ?? p.repo;
---

<article
	class:list={['project-card reveal group', large && 'md:col-span-2']}
	data-category={p.category}
	style={`--d:${(index % 3) * 90}ms`}
>
	<div class="spot-card flex h-full flex-col overflow-hidden" data-tilt={large ? '4' : '7'} data-spotlight-card>
		<div class="tilt-glare" data-tilt-glare></div>

		<!-- Cover -->
		<a href={primaryHref} target="_blank" rel="noopener" class:list={['relative z-0 block overflow-hidden', large ? 'aspect-[16/8]' : 'aspect-[16/10]']} tabindex="-1" aria-hidden="true">
			{p.image ? (
				<Image src={p.image} alt="" width={large ? 1200 : 800} class="h-full w-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.06]" loading="lazy" />
			) : (
				<div class="relative flex h-full w-full items-center justify-center overflow-hidden" style={`background: radial-gradient(120% 120% at 0% 0%, ${p.accent[0]}55, transparent 60%), radial-gradient(120% 120% at 100% 100%, ${p.accent[1]}55, transparent 60%), #0b0d14;`}>
					<div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.05)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.05)_1px,transparent_1px)] bg-[size:28px_28px] [mask-image:radial-gradient(circle_at_center,black,transparent_75%)]"></div>
					<span class="relative font-display text-3xl font-bold tracking-tight text-white/90 transition-transform duration-700 group-hover:scale-110 sm:text-4xl">{p.title}</span>
					<span class="absolute bottom-3 left-4 font-mono text-[10px] uppercase tracking-widest text-white/40">{'</>'} {p.tags[0]}</span>
				</div>
			)}
			<div class="absolute inset-0 bg-gradient-to-t from-[#07080d] via-transparent to-transparent opacity-90"></div>
			<span class="absolute left-4 top-4 font-mono text-[11px] text-white/50">{String(index + 1).padStart(2, '0')}</span>
			{statusLabel && (
				<span class={`absolute right-4 top-4 rounded-full border px-2.5 py-1 font-mono text-[10px] uppercase tracking-wider backdrop-blur ${statusClass}`}>{statusLabel}</span>
			)}
		</a>

		<!-- Body -->
		<div class="relative z-10 flex flex-1 flex-col p-6" style="transform: translateZ(30px)">
			<div class="mb-3 flex flex-wrap gap-1.5">
				{p.tags.map((tag) => (
					<span class="rounded-md bg-white/5 px-2 py-0.5 font-mono text-[11px] text-slate-400">{tag}</span>
				))}
			</div>
			<h3 class:list={['font-display font-semibold text-white', large ? 'text-2xl sm:text-3xl' : 'text-xl']}>{p.title}</h3>
			<p class="mt-2 flex-1 text-sm leading-relaxed text-slate-400">{p.desc[lang]}</p>

			<div class="mt-6 flex flex-wrap gap-2">
				{p.live && (
					<a href={p.live} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-full bg-white px-4 py-2 text-xs font-semibold text-void transition-transform hover:scale-105">
						{t('card.live')} <span aria-hidden="true">↗</span>
					</a>
				)}
				{p.playStore && (
					<a href={p.playStore} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-full bg-white px-4 py-2 text-xs font-semibold text-void transition-transform hover:scale-105">
						▶ {t('card.store')}
					</a>
				)}
				{p.appStore && (
					<span class="inline-flex cursor-default items-center gap-1.5 rounded-full border border-dashed border-orange-300/40 px-4 py-2 text-xs font-semibold text-orange-200/90">
						{t('card.appstoreSoon')}
					</span>
				)}
				{p.repo && (
					<a href={p.repo} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-full border border-white/15 px-4 py-2 text-xs font-semibold text-slate-200 transition-colors hover:border-white/40 hover:text-white">
						<svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" /></svg>
						{t('card.repo')}
					</a>
				)}
			</div>
		</div>
	</div>
</article>
